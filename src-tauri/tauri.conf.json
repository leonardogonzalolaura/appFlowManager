{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowManager",
  "version": "0.1.6",
  "identifier": "com.leona.flowmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlowManager",
        "width": 1200,
        "height": 700,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "maximized": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Orquesta requerimientos, ramas y despliegues",
    "longDescription": "FlowManager centraliza requerimientos, repositorios, ramas de despliegue y scripts de base de datos."
  }
}
